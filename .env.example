# Copy to .env and fill in. Never commit the real .env.
# Generate passwords: openssl rand -base64 24

# ── global ────────────────────────────────────────────────────────────────────
TZ=Europe/London

# The node's MagicDNS name, no trailing dot, no port.
# Detect it with:  tailscale status --json | grep -o '"DNSName":"[^"]*"' | head -1
# Or just read it off `tailscale status` / the admin console.
TAILNET_HOST=node.tailnet-name.ts.net

# ── runtime ───────────────────────────────────────────────────────────────────
# Host API socket, mounted into socket-proxy and the Beszel agent.
#   Docker Engine:     /var/run/docker.sock
#   Podman rootful:    /run/podman/podman.sock
#   Podman rootless:   /run/user/1000/podman/podman.sock   (your uid)
DOCKER_SOCK=/var/run/docker.sock

# ── ntfy ──────────────────────────────────────────────────────────────────────
# One random topic, unguessable. Write-only for anonymous publishers, readable
# only by a logged-in user (see README). Rotate by changing this + restarting.
NTFY_ALERT_TOPIC=alerts-replacewith32randomchars

# ── beszel ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=you@example.com
BESZEL_ADMIN_PASSWORD=replace-me
# Both come from the hub UI (Beszel -> Add System) after the first start.
# KEY is required or the agent exits on boot; TOKEN enables WebSocket registration.
BESZEL_KEY=
BESZEL_TOKEN=

# ── apps ──────────────────────────────────────────────────────────────────────
LINKDING_ADMIN_USER=admin
LINKDING_ADMIN_PASSWORD=replace-me

MINIFLUX_DB_PASSWORD=replace-me
MINIFLUX_ADMIN_USER=admin
MINIFLUX_ADMIN_PASSWORD=replace-me
